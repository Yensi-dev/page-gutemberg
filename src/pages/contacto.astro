---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const oficinas = [
  {
    num: '01',
    key: 'con.rd',
    pais: 'República Dominicana',
    dir: 'Blvd. Turístico del Este, Cabo Engaño, Punta Cana 23000, Calle 3ra. No. 3, Proy. Caribbean Bávaro',
  },
  {
    num: '02',
    key: 'con.us',
    pais: 'Estados Unidos',
    dir: '100 Cummings Center, Suite 321B, Beverly, MA 01905, Estados Unidos',
  },
  {
    num: '03',
    key: 'con.mx',
    pais: 'México',
    dir: 'Educación 194 Int. 8, Tercer Piso, Burócrata, 78270 San Luis Potosí, México',
  },
];
---

<Layout title="Guttemberg SRL | Contacto">
  <Nav />
  <main>

    <!-- Hero -->
    <section class="page-hero">
      <div class="hero-bg">
        <video
          src="/video/contact.mp4"
          class="hero-img"
          autoplay
          muted
          loop
        />
        <div class="hero-overlay"></div>
      </div>
      <div class="container hero-content">
        <span class="label"><span class="line-accent"></span><span data-i18n="con.label">Contacto</span></span>
        <h1 class="hero-title" data-i18n-html data-i18n="con.title">Hablemos de<br />tu proyecto.</h1>
        <p class="hero-sub" data-i18n="con.sub">
          Envíanos tu plano o descripción y te respondemos
          en menos de 24 horas hábiles.
        </p>
      </div>
    </section>

    <!-- Oficinas / Ubicaciones -->
    <section class="oficinas-section">
      <div class="container">
        <div class="oficinas-header">
          <span class="label"><span class="line-accent"></span><span data-i18n="con.oficinas.label">Presencia Global</span></span>
          <h2 class="oficinas-title" data-i18n="con.oficinas.title">Presencia en varios países.</h2>
        </div>
        <div class="oficinas-row">
          {oficinas.map(o => (
            <div class="oficina-card">
              <div class="oficina-top">
                <span class="oficina-icon">
                  <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </span>
                <span class="oficina-num">{o.num}</span>
              </div>
              <h3 class="oficina-pais" data-i18n={`${o.key}.pais`}>{o.pais}</h3>
              <div class="oficina-divider"></div>
              <p class="oficina-dir" data-i18n={`${o.key}.dir`}>{o.dir}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contacto principal -->
    <section class="contacto-section">
      <div class="container contacto-inner">

        <!-- Info izquierda -->
        <div class="contact-info">
          <span class="label"><span class="line-accent"></span><span data-i18n="con.info.label">Información</span></span>
          <h2 class="info-title" data-i18n-html data-i18n="con.info.title">Estamos listos<br />para ayudarte.</h2>
          <p class="info-desc" data-i18n="con.info.desc">
            Ya sea un prototipo, una producción en serie o un repuesto
            urgente, nuestro equipo está disponible para atenderte
            y darte una cotización precisa.
          </p>

          <ul class="info-list">
            <li class="info-item">
              <div class="info-icon">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div class="info-text">
                <span class="info-label" data-i18n="con.ubicacion.l">Ubicación</span>
                <span class="info-val" data-i18n="con.ubicacion.v">Santo Domingo, República Dominicana</span>
              </div>
            </li>
            <li class="info-item">
              <div class="info-icon">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.85a16 16 0 0 0 6.29 6.29l1.94-1.94a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div class="info-text">
                <span class="info-label" data-i18n="con.telefono.l">Teléfono</span>
                <span class="info-val">(829) 734-5100</span>
              </div>
            </li>
            <li class="info-item">
              <div class="info-icon">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div class="info-text">
                <span class="info-label" data-i18n="con.correo.l">Correo</span>
                <span class="info-val">info@guttembergusa.com</span>
              </div>
            </li>
            <li class="info-item">
              <div class="info-icon">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div class="info-text">
                <span class="info-label" data-i18n="con.horario.l">Horario</span>
                <span class="info-val" data-i18n="con.horario.v">Lun – Vie, 8:00 am – 5:00 pm</span>
              </div>
            </li>
          </ul>

          <div class="social-row">
            <a href="#" class="social-btn" aria-label="Facebook">
              <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="#" class="social-btn" aria-label="Instagram">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="#" class="social-btn" aria-label="LinkedIn">
              <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="#" class="social-btn" aria-label="WhatsApp">
              <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </a>
          </div>
        </div>

        <!-- Formulario derecha -->
        <div class="contact-form-wrap">
          <form class="contact-form" id="contactForm">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" data-i18n="form.nombre">Nombre</label>
                <input type="text" class="form-input" placeholder="Tu nombre completo" data-i18n="form.nombre.ph" />
              </div>
              <div class="form-group">
                <label class="form-label" data-i18n="form.empresa">Empresa</label>
                <input type="text" class="form-input" placeholder="Nombre de tu empresa" data-i18n="form.empresa.ph" />
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" data-i18n="form.correo">Correo electrónico</label>
                <input type="email" class="form-input" placeholder="correo@empresa.com" data-i18n="form.correo.ph" />
              </div>
              <div class="form-group">
                <label class="form-label" data-i18n="form.telefono">Teléfono</label>
                <input type="tel" class="form-input" placeholder="(809) 000-0000" data-i18n="form.telefono.ph" />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="form.servicio">Tipo de servicio</label>
              <select class="form-input form-select">
                <option value="" disabled selected data-i18n="form.servicio.ph">Selecciona un servicio</option>
                <option data-i18n="form.servicio.o1">Mecanizado CNC</option>
                <option data-i18n="form.servicio.o2">Prototipos Rápidos</option>
                <option data-i18n="form.servicio.o3">Producción en Serie</option>
                <option data-i18n="form.servicio.o4">Repuestos Industriales</option>
                <option data-i18n="form.servicio.o5">Otro</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="form.desc">Descripción del proyecto</label>
              <textarea class="form-input form-textarea" placeholder="Describe tu pieza, material, tolerancias, cantidad y cualquier detalle relevante..." data-i18n="form.desc.ph"></textarea>
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="form.adjuntar">Adjuntar plano o archivo (opcional)</label>
              <div class="file-drop" id="fileDrop">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span><span data-i18n="form.arrastra">Arrastra tu archivo aquí o </span><label class="file-browse"><span data-i18n="form.selecciona">selecciona uno</span><input type="file" class="file-input" accept=".pdf,.dxf,.step,.iges,.jpg,.png" /></label></span>
                <span class="file-types" data-i18n="form.tipos">PDF, DXF, STEP, IGES, JPG — máx. 10 MB</span>
              </div>
            </div>
            <button type="submit" class="form-btn">
              <span data-i18n="form.enviar">Enviar solicitud</span>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </form>
        </div>

      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
/* Hero */
.page-hero {
  position: relative;
  height: 60vh;
  min-height: 450px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.hero-bg { position: absolute; inset: 0; }
.hero-img {
  width: 100%; height: 100%;
  object-fit: cover;
  filter: brightness(0.4) saturate(0.8);
}
.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(5,15,35,0.9) 0%, rgba(5,15,35,0.2) 100%);
}
.hero-content {
  position: relative; z-index: 2;
  padding-bottom: 4rem;
  display: flex; flex-direction: column; gap: 1rem;
}
.hero-title {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 700; color: #ffffff; line-height: 1.05;
}
.hero-sub {
  font-size: 1rem; color: rgba(255,255,255,0.6);
  font-weight: 300; max-width: 480px; line-height: 1.7;
}

/* Oficinas */
.oficinas-section {
  padding-block: clamp(5rem, 10vh, 8rem);
  background: #ffffff;
}
.oficinas-header {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: clamp(3.5rem, 7vh, 6rem);
  max-width: 640px;
}
.oficinas-title {
  font-family: var(--font-display);
  font-size: clamp(1.7rem, 3vw, 2.4rem);
  font-weight: 700;
  color: var(--c-text);
  line-height: 1.1;
}
.oficinas-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}
.oficina-card {
  position: relative;
  padding: 2.5rem 2rem 2.25rem;
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
  background: #ffffff;
  box-shadow: 0 8px 32px rgba(27, 62, 110, 0.14);
  overflow: hidden;
  transition: box-shadow 0.35s ease, transform 0.35s ease;
}
.oficina-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--c-accent-2), var(--c-accent));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.4s ease;
}
.oficina-card:hover {
  box-shadow: 0 16px 40px rgba(27,61,110,0.16);
  transform: translateY(-4px);
}
.oficina-card:hover::before {
  transform: scaleX(1);
}

.oficina-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.oficina-icon {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-accent-2);
  background: rgba(42, 82, 152, 0.08);
  flex-shrink: 0;
}
.oficina-num {
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  font-weight: 700;
  color: var(--c-muted);
}
.oficina-pais {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--c-text);
  line-height: 1.15;
}
.oficina-divider {
  width: 32px;
  height: 2px;
  background: var(--c-border);
}
.oficina-dir {
  font-size: 0.88rem;
  color: var(--c-text-soft);
  line-height: 1.75;
}

@media (max-width: 780px) {
  .oficinas-row {
    grid-template-columns: 1fr;
  }
}

/* Sección principal */
.contacto-section {
  padding-block: clamp(6rem, 12vh, 10rem);
  background: #f4f6f9;
}
.contacto-inner {
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: clamp(3rem, 8vw, 7rem);
  align-items: start;
}

/* Info */
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  position: sticky;
  top: 120px;
}
.info-title {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 700;
  color: var(--c-text);
  line-height: 1.1;
}
.info-desc {
  font-size: 0.93rem;
  color: var(--c-text-soft);
  line-height: 1.8;
}
.info-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.info-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}
.info-icon {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  background: #ffffff;
  border: 1px solid var(--c-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-accent-2);
  flex-shrink: 0;
}
.info-text {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  padding-top: 0.2rem;
}
.info-label {
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--c-muted);
}
.info-val {
  font-size: 0.92rem;
  color: var(--c-text);
  font-weight: 500;
}

/* Social */
.social-row {
  display: flex;
  gap: 0.6rem;
}
.social-btn {
  width: 38px;
  height: 38px;
  border: 1px solid var(--c-border);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-muted);
  background: #ffffff;
  transition: border-color 0.2s, color 0.2s;
}
.social-btn:hover {
  border-color: var(--c-accent-2);
  color: var(--c-accent-2);
}

/* Formulario */
.contact-form-wrap {
  background: #ffffff;
  border: 1px solid var(--c-border);
  border-radius: 12px;
  padding: clamp(2rem, 4vw, 3rem);
}
.contact-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
}
.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.form-label {
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--c-text);
}
.form-input {
  font-family: var(--font-body);
  font-size: 0.92rem;
  color: var(--c-text);
  background: #f8fafc;
  border: 1px solid var(--c-border);
  border-radius: 6px;
  padding: 0.75rem 1rem;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  width: 100%;
}
.form-input:focus {
  border-color: var(--c-accent-2);
  box-shadow: 0 0 0 3px rgba(42, 82, 152, 0.08);
  background: #ffffff;
}
.form-input::placeholder { color: var(--c-muted); }
.form-select { cursor: pointer; }
.form-textarea {
  min-height: 130px;
  resize: vertical;
  line-height: 1.6;
}

/* File drop */
.file-drop {
  border: 1.5px dashed var(--c-border);
  border-radius: 6px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  text-align: center;
  color: var(--c-muted);
  font-size: 0.85rem;
  background: #f8fafc;
  transition: border-color 0.2s;
  cursor: pointer;
}
.file-drop:hover { border-color: var(--c-accent-2); }
.file-browse {
  color: var(--c-accent-2);
  font-weight: 600;
  cursor: pointer;
  text-decoration: underline;
}
.file-input { display: none; }
.file-types {
  font-size: 0.72rem;
  color: var(--c-border);
  letter-spacing: 0.05em;
}

/* Botón submit */
.form-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  font-family: var(--font-body);
  font-size: 0.8rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 700;
  padding: 1rem 2.4rem;
  background: #0d1f42;
  color: #ffffff;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  transition: background 0.25s, transform 0.2s;
  align-self: flex-start;
}
.form-btn:hover {
  background: var(--c-accent-2);
  transform: translateY(-1px);
}

@media (max-width: 860px) {
  .contacto-inner { grid-template-columns: 1fr; }
  .contact-info { position: static; }
  .form-row { grid-template-columns: 1fr; }
}
</style>