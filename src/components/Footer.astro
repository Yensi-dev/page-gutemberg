---
const links = [
  { href: '/',          label: 'Inicio',    key: 'nav.inicio' },
  { href: '/servicios', label: 'Servicios', key: 'nav.servicios' },
  { href: '/nosotros',  label: 'Nosotros',  key: 'nav.nosotros' },
  { href: '/contacto',  label: 'Contacto',  key: 'nav.contacto' },
];

const locations = [
  { country: 'Estados Unidos',        key: 'foot.loc.us',  cityKey: 'foot.loc.us.city',  city: 'Beverly, MA 01915',           phone: '+1 (978) 867-0707' },
  { country: 'México',                key: 'foot.loc.mx',  cityKey: 'foot.loc.mx.city',  city: 'San Luis Potosí, 78270',       phone: '+52 (444) 892-2917' },
  { country: 'República Dominicana',  key: 'foot.loc.do',  cityKey: 'foot.loc.do.city',  city: 'Punta Cana 23000',             phone: '+1 (829) 734-5100' },
];
---

<footer class="footer">
  <div class="container footer-inner">

    <!-- Columna 1: Logo + descripción + redes -->
    <div class="col col-brand">
      <a href="/" class="footer-logo">
        <img src="/images/logo.png" alt="Guttemberg Precision Machining" class="footer-logo-img" />
      </a>
      <p class="footer-desc" data-i18n="foot.desc">
        Fabricación de piezas de precisión para la industria.
        Calidad, exactitud y cumplimiento en cada proyecto.
      </p>
      <div class="social-links">
        <a href="#" class="social-btn" aria-label="Facebook">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="#" class="social-btn" aria-label="Instagram">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="#" class="social-btn" aria-label="LinkedIn">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <a href="#" class="social-btn" aria-label="WhatsApp">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </a>
      </div>
    </div>

    <!-- Columna 2: Navegación -->
    <div class="col col-nav">
      <h4 class="col-title" data-i18n="foot.nav">Navegación</h4>
      <ul class="footer-links">
        {links.map(l => (
          <li><a href={l.href} class="footer-link" data-i18n={l.key}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Columna 3: Servicios -->
    <div class="col col-services">
      <h4 class="col-title" data-i18n="foot.serv">Servicios</h4>
      <ul class="footer-links">
        <li><a href="/servicios" class="footer-link" data-i18n="foot.serv1">Mecanizado CNC</a></li>
        <li><a href="/servicios" class="footer-link" data-i18n="foot.serv2">Prototipos</a></li>
        <li><a href="/servicios" class="footer-link" data-i18n="foot.serv3">Producción en serie</a></li>
        <li><a href="/servicios" class="footer-link" data-i18n="foot.serv4">Repuestos Industriales</a></li>
      </ul>
    </div>

    <!-- Columna 4: Ubicaciones -->
    <div class="col col-contact">
      <h4 class="col-title" data-i18n="foot.contacto">Ubicaciones</h4>
      <ul class="location-list">
        {locations.map(loc => (
          <li class="location-item">
            <span class="contact-icon">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <div class="location-text">
              <span class="location-country" data-i18n={loc.key}>{loc.country}</span>
              <span class="location-city" data-i18n={loc.cityKey}>{loc.city}</span>
              <a href={`tel:${loc.phone.replace(/[^+\d]/g, '')}`} class="location-phone">{loc.phone}</a>
            </div>
          </li>
        ))}
      </ul>

      <div class="contact-general">
        <a href="mailto:info@guttembergusa.com" class="footer-link contact-line">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span>info@guttembergusa.com</span>
        </a>
      </div>
    </div>

  </div>

  <!-- Barra inferior -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="copyright">© {new Date().getFullYear()} Guttemberg Precision Machining. <span data-i18n="foot.copyright">Todos los derechos reservados.</span></p>
      <p class="credits"><span data-i18n="foot.credits">Diseño web por</span> <a href="https://tainosf.com" class="credits-link" target="_blank"> Taino Software Factory</a></p>
    </div>
  </div>
</footer>

<style>
.footer {
  background: #0a1224;
  border-top: 1px solid rgba(255,255,255,0.06);
  padding-top: clamp(3.5rem, 8vh, 6rem);
}

.footer-inner {
  display: grid;
  grid-template-columns: 1.3fr 0.8fr 0.8fr 1.4fr;
  gap: clamp(2rem, 5vw, 4rem);
  padding-bottom: clamp(3rem, 6vh, 5rem);
}

/* Logo */
.footer-logo-img {
  height: 44px;
  width: auto;
  object-fit: contain;
  margin-bottom: 1.2rem;
  opacity: 0.9;
}

.footer-desc {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.4);
  line-height: 1.75;
  margin-bottom: 1.5rem;
  max-width: 260px;
}

/* Social */
.social-links {
  display: flex;
  gap: 0.6rem;
}
.social-btn {
  width: 36px;
  height: 36px;
  border: 1px solid rgba(255,255,255,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.45);
  border-radius: 4px;
  transition: border-color 0.2s, color 0.2s, background 0.2s;
}
.social-btn:hover {
  border-color: rgba(255,255,255,0.4);
  color: #ffffff;
  background: rgba(255,255,255,0.06);
}

/* Columna títulos */
.col-title {
  font-family: var(--font-body);
  font-size: 0.68rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 700;
  color: rgba(255,255,255,0.35);
  margin-bottom: 1.5rem;
}

/* Links */
.footer-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.footer-link {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.55);
  transition: color 0.2s, padding-left 0.2s;
  display: inline-block;
}
.footer-link:hover {
  color: #ffffff;
  padding-left: 4px;
}

/* Ubicaciones */
.location-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.2rem 1rem;
  margin-bottom: 1.4rem;
}
.location-item {
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
  min-width: 160px; /* nuevo: da más espacio al título */
}
.location-text {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}
.location-country {
  font-size: 0.82rem;
  font-weight: 600;
  color: rgba(255,255,255,0.95); /* antes 0.75 */
}
.location-city {
  font-size: 0.78rem;
  color: rgba(255,255,255,0.65); /* antes 0.4 */
}
.contact-icon {
  color: rgba(255,255,255,0.55); /* antes 0.3 */
  margin-top: 2px;
  flex-shrink: 0;
}

.location-phone {
  font-size: 0.78rem;
  color: rgba(255,255,255,0.65);
  margin-top: 0.15rem;
  transition: color 0.2s;
}
.location-phone:hover {
  color: #ffffff;
}

/* Contacto general (tel/email) */
.contact-general {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin-top: 1.4rem; /* separación sin línea */
}

.contact-line {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  font-size: 0.82rem;
}
.contact-line svg {
  flex-shrink: 0;
  color: rgba(255,255,255,0.3);
}

/* Barra inferior */
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.06);
  padding-block: 1.25rem;
}
.footer-bottom-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.copyright {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.25);
}
.credits {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.25);
}
.credits-link {
  color: rgba(255,255,255,0.45);
  transition: color 0.2s;
}
.credits-link:hover { color: #ffffff; }

@media (max-width: 900px) {
  .footer-inner {
    grid-template-columns: 1fr 1fr;
  }
}
@media (max-width: 560px) {
  .footer-inner {
    grid-template-columns: 1fr;
  }
  .footer-bottom-inner {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>