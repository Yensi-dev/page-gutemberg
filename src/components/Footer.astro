---
const links = [
  { href: '/',          label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/galeria',   label: 'Galería' },
  { href: '/nosotros',  label: 'Nosotros' },
  { href: '/contacto',  label: 'Contacto' },
];
---

<footer class="footer">
  <div class="container footer-inner">

    <!-- Columna 1: Logo + descripción + redes -->
    <div class="col col-brand">
      <a href="/" class="footer-logo">
        <img src="/images/logo.png" alt="Guttemberg Precision Machining" class="footer-logo-img" />
      </a>
      <p class="footer-desc">
        Fabricación de piezas de precisión para la industria.
        Calidad, exactitud y cumplimiento en cada proyecto.
      </p>
      <div class="social-links">
        <a href="#" class="social-btn" aria-label="Facebook">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="#" class="social-btn" aria-label="Instagram">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="#" class="social-btn" aria-label="LinkedIn">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <a href="#" class="social-btn" aria-label="WhatsApp">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </a>
      </div>
    </div>

    <!-- Columna 2: Navegación -->
    <div class="col col-nav">
      <h4 class="col-title">Navegación</h4>
      <ul class="footer-links">
        {links.map(l => (
          <li><a href={l.href} class="footer-link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Columna 3: Servicios -->
    <div class="col col-services">
      <h4 class="col-title">Servicios</h4>
      <ul class="footer-links">
        <li><a href="/servicios" class="footer-link">Mecanizado CNC</a></li>
        <li><a href="/servicios" class="footer-link">Torneado</a></li>
        <li><a href="/servicios" class="footer-link">Fresado</a></li>
        <li><a href="/servicios" class="footer-link">Prototipos</a></li>
        <li><a href="/servicios" class="footer-link">Producción en serie</a></li>
      </ul>
    </div>

    <!-- Columna 4: Contacto -->
    <div class="col col-contact">
      <h4 class="col-title">Contacto</h4>
      <ul class="contact-list">
        <li>
          <span class="contact-icon">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <span>Santo Domingo,<br />República Dominicana</span>
        </li>
        <li>
          <span class="contact-icon">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.85a16 16 0 0 0 6.29 6.29l1.94-1.94a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          <span>(809) 000-0000</span>
        </li>
        <li>
          <span class="contact-icon">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </span>
          <span>info@guttemberg.com</span>
        </li>
      </ul>
    </div>

  </div>

  <!-- Barra inferior -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="copyright">© {new Date().getFullYear()} Guttemberg Precision Machining. Todos los derechos reservados.</p>
      <p class="credits">Diseño web por <a href="#" class="credits-link">TAINOSF</a></p>
    </div>
  </div>
</footer>

<style>
.footer {
  background: #0a1224;
  border-top: 1px solid rgba(255,255,255,0.06);
  padding-top: clamp(3.5rem, 8vh, 6rem);
}

.footer-inner {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
  gap: clamp(2rem, 5vw, 4rem);
  padding-bottom: clamp(3rem, 6vh, 5rem);
}

/* Logo */
.footer-logo-img {
  height: 44px;
  width: auto;
  object-fit: contain;
  margin-bottom: 1.2rem;
  opacity: 0.9;
}

.footer-desc {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.4);
  line-height: 1.75;
  margin-bottom: 1.5rem;
  max-width: 260px;
}

/* Social */
.social-links {
  display: flex;
  gap: 0.6rem;
}
.social-btn {
  width: 36px;
  height: 36px;
  border: 1px solid rgba(255,255,255,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.45);
  border-radius: 4px;
  transition: border-color 0.2s, color 0.2s, background 0.2s;
}
.social-btn:hover {
  border-color: rgba(255,255,255,0.4);
  color: #ffffff;
  background: rgba(255,255,255,0.06);
}

/* Columna títulos */
.col-title {
  font-family: var(--font-body);
  font-size: 0.68rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 700;
  color: rgba(255,255,255,0.35);
  margin-bottom: 1.5rem;
}

/* Links */
.footer-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.footer-link {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.55);
  transition: color 0.2s, padding-left 0.2s;
  display: inline-block;
}
.footer-link:hover {
  color: #ffffff;
  padding-left: 4px;
}

/* Contacto */
.contact-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.contact-list li {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  font-size: 0.88rem;
  color: rgba(255,255,255,0.55);
  line-height: 1.6;
}
.contact-icon {
  color: rgba(255,255,255,0.3);
  margin-top: 2px;
  flex-shrink: 0;
}

/* Barra inferior */
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.06);
  padding-block: 1.25rem;
}
.footer-bottom-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.copyright {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.25);
}
.credits {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.25);
}
.credits-link {
  color: rgba(255,255,255,0.45);
  transition: color 0.2s;
}
.credits-link:hover { color: #ffffff; }

@media (max-width: 900px) {
  .footer-inner {
    grid-template-columns: 1fr 1fr;
  }
}
@media (max-width: 560px) {
  .footer-inner {
    grid-template-columns: 1fr;
  }
  .footer-bottom-inner {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>