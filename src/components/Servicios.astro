---
const servicios = [
  {
    num: '01',
    titulo: 'Mecanizado CNC',
    desc: 'Fresado y torneado de 3 y 5 ejes con tolerancias hasta ±0.01 mm.',
    img: 'https://images.unsplash.com/photo-1581091226033-d5c48150dbaa?w=800&q=80',
  },
  {
    num: '02',
    titulo: 'Prototipos Rápidos',
    desc: 'De tu diseño CAD a pieza física en días.',
    img: 'https://images.unsplash.com/photo-1565043589221-1a6fd9ae45c7?w=800&q=80',
  },
  {
    num: '03',
    titulo: 'Producción en Serie',
    desc: 'Lotes medianos y grandes con control dimensional en cada pieza.',
    img: 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=800&q=80',
  },
  {
    num: '04',
    titulo: 'Repuestos Industriales',
    desc: 'Fabricamos repuestos bajo plano o muestra para tu maquinaria.',
    img: 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&q=80',
  },
];
---

<section class="servicios-section">
  <div class="container">

    <div class="section-header">
      <span class="label"><span class="line-accent"></span>Servicios</span>
      <div class="header-row">
        <h2 class="section-title">Lo que hacemos</h2>
        <a href="/servicios" class="ver-todos">Ver todos →</a>
      </div>
    </div>

    <div class="servicios-grid">
      {servicios.map(s => (
        <a href="/servicios" class="card">
          <div class="card-img-wrap">
            <img src={s.img} alt={s.titulo} class="card-img" />
            <div class="card-overlay"></div>
            <span class="card-num">{s.num}</span>
          </div>
          <div class="card-body">
            <h3 class="card-titulo">{s.titulo}</h3>
            <p class="card-desc">{s.desc}</p>
            <span class="card-link">Ver más →</span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
.servicios-section {
  padding-block: clamp(5rem, 10vh, 8rem);
  background: #ffffff;
}

.section-header {
  margin-bottom: clamp(2.5rem, 5vh, 4rem);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.header-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.section-title {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  font-weight: 700;
  color: var(--c-text);
  line-height: 1.1;
}

.ver-todos {
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  font-weight: 600;
  color: var(--c-accent-2);
  text-transform: uppercase;
  transition: color 0.2s;
  padding-bottom: 2px;
  border-bottom: 1px solid var(--c-accent-2);
}
.ver-todos:hover { color: var(--c-accent); }

/* Grid */
.servicios-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
}

/* Card */
.card {
  display: flex;
  flex-direction: column;
  background: #f8fafc;
  border: 1px solid var(--c-border);
  border-radius: 8px;
  overflow: hidden;
  transition: transform 0.3s, box-shadow 0.3s;
  cursor: pointer;
}
.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 32px rgba(27, 61, 110, 0.1);
}

/* Imagen con overlay */
.card-img-wrap {
  position: relative;
  height: 200px;
  overflow: hidden;
}
.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
  filter: brightness(0.9) saturate(0.85);
}
.card:hover .card-img {
  transform: scale(1.05);
}
.card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(8, 20, 50, 0.15) 0%,
    rgba(8, 20, 50, 0.55) 100%
  );
}
.card-num {
  position: absolute;
  top: 1rem;
  left: 1rem;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  color: rgba(255,255,255,0.7);
}

/* Body */
.card-body {
  padding: 1.4rem 1.5rem 1.6rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  flex: 1;
}

.card-titulo {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--c-text);
  line-height: 1.15;
}

.card-desc {
  font-size: 0.83rem;
  color: var(--c-text-soft);
  line-height: 1.65;
  flex: 1;
}

.card-link {
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  font-weight: 700;
  color: var(--c-accent-2);
  text-transform: uppercase;
  margin-top: 0.5rem;
  transition: color 0.2s;
}
.card:hover .card-link { color: var(--c-accent); }

@media (max-width: 900px) {
  .servicios-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 500px) {
  .servicios-grid { grid-template-columns: 1fr; }
}
</style>