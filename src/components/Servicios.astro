---
const servicios = [
  {
    num: '01',
    titulo: 'Mecanizado CNC',
    desc: 'Fresado y torneado de 3 y 5 ejes con tolerancias hasta ±0.01 mm en acero, aluminio, titanio y plásticos técnicos.',
    img: 'https://images.unsplash.com/photo-1581091226033-d5c48150dbaa?w=1000&q=80',
  },
  {
    num: '02',
    titulo: 'Prototipos Rápidos',
    desc: 'De tu diseño CAD a pieza física en días. Validamos geometría y materiales antes de la producción en serie.',
    img: 'https://images.unsplash.com/photo-1565043589221-1a6fd9ae45c7?w=1000&q=80',
  },
  {
    num: '03',
    titulo: 'Producción en Serie',
    desc: 'Lotes medianos y grandes con consistencia garantizada y control dimensional en cada pieza.',
    img: 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=1000&q=80',
  },
  {
    num: '04',
    titulo: 'Repuestos Industriales',
    desc: 'Fabricamos repuestos bajo plano o muestra para reducir el tiempo de paro de tus máquinas.',
    img: 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=1000&q=80',
  },
];
---

<section class="servicios-section">
  <div class="container">

    <div class="section-header">
      <span class="label"><span class="line-accent"></span>Servicios</span>
      <h2 class="section-title">Lo que hacemos</h2>
    </div>

    <div class="servicios-list">
      {servicios.map((s, i) => (
        <article class={`servicio-item ${i % 2 !== 0 ? 'reverse' : ''}`}>
          <div class="servicio-img-wrap">
            <img src={s.img} alt={s.titulo} class="servicio-img" />
          </div>
          <div class="servicio-info">
            <span class="item-num">{s.num}</span>
            <h3 class="item-titulo">{s.titulo}</h3>
            <p class="item-desc">{s.desc}</p>
            <a href="/servicios" class="item-link">
              Ver más
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
.servicios-section {
  padding-block: clamp(5rem, 10vh, 8rem);
  background: #f4f6f9;
}

.section-header {
  margin-bottom: clamp(3rem, 6vh, 4.5rem);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.section-title {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  font-weight: 700;
  color: var(--c-text);
  line-height: 1.1;
}

/* Lista */
.servicios-list {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.servicio-item {
  display: flex;
  align-items: stretch;
  min-height: 420px;
  overflow: hidden;
  border-radius: 12px;
  box-shadow: 0 2px 16px rgba(27, 61, 110, 0.07);
  background: #ffffff;
  transition: box-shadow 0.35s, transform 0.35s;
}
.servicio-item:hover {
  box-shadow: 0 8px 36px rgba(27, 61, 110, 0.12);
  transform: translateY(-3px);
}
.servicio-item:last-child {
  margin-bottom: 0;
}
.servicio-item.reverse {
  flex-direction: row-reverse;
}

/* Imagen fija */
.servicio-img-wrap {
  width: 520px;
  min-width: 520px;
  height: 420px;
  flex-shrink: 0;
  overflow: hidden;
}
.servicio-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 0.7s ease;
  filter: brightness(0.95) saturate(0.85);
}
.servicio-item:hover .servicio-img {
  transform: scale(1.03);
}

/* Info */
.servicio-info {
  flex: 1;
  padding: clamp(2rem, 4vw, 3.5rem);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1rem;
}

.item-num {
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  color: var(--c-accent-2);
}

.item-titulo {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 2.5vw, 2.1rem);
  font-weight: 700;
  color: var(--c-text);
  line-height: 1.1;
}

.item-desc {
  font-size: 0.92rem;
  color: var(--c-text-soft);
  line-height: 1.78;
  max-width: 400px;
}

.item-link {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  font-weight: 700;
  color: var(--c-accent-2);
  text-transform: uppercase;
  margin-top: 0.25rem;
  transition: gap 0.25s, color 0.2s;
  width: fit-content;
}
.item-link:hover {
  gap: 0.8rem;
  color: var(--c-accent);
}

@media (max-width: 860px) {
  .servicio-item,
  .servicio-item.reverse {
    flex-direction: column;
    min-height: auto;
  }
  .servicio-img-wrap {
    width: 100%;
    min-width: 100%;
    height: 260px;
  }
}
</style>