---
const links = [
  { href: '/',          label: 'Inicio', key: 'nav.inicio' },
  { href: '/servicios', label: 'Servicios', key: 'nav.servicios' },
  { href: '/nosotros',  label: 'Nosotros', key: 'nav.nosotros' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="nav-wrap" id="mainNav">
  <nav class="container nav-inner">

    <a href="/" class="nav-logo">
      <img src="/images/logo.png" alt="Guttemberg Precision Machining" class="logo-img" />
    </a>

    <ul class="nav-links" id="navLinks">
      {links.map(l => (
        <li>
          <a href={l.href} class={`nav-link ${currentPath === l.href ? 'active' : ''}`} data-i18n={l.key}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      <a href="/contacto" class="nav-cta" data-i18n="nav.contacto">Contacto</a>
      <div class="lang-toggle" id="langBtn" data-active="es" role="button" tabindex="0" aria-label="Cambiar idioma">
        <svg class="lang-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>
        <span class="lang-track">
          <span class="lang-opt active" data-lang="es">ES</span>
          <span class="lang-opt" data-lang="en">EN</span>
          <span class="lang-indicator"></span>
        </span>
      </div>
    </div>

    <button class="nav-toggle" aria-label="Menú" id="menuBtn">
      <span></span><span></span><span></span>
    </button>

  </nav>

  <div class="mobile-menu" id="mobileMenu">
    {links.map(l => (
      <a href={l.href} class="mobile-link" data-i18n={l.key}>{l.label}</a>
    ))}
    <a href="/contacto" class="nav-cta mobile-cta" data-i18n="nav.contacto">Contacto</a>
    <div class="lang-toggle mobile-lang" id="langBtnMobile" data-active="es" role="button" tabindex="0" aria-label="Cambiar idioma">
      <svg class="lang-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>
      <span class="lang-track">
        <span class="lang-opt active" data-lang="es">ES</span>
        <span class="lang-opt" data-lang="en">EN</span>
        <span class="lang-indicator"></span>
      </span>
    </div>
  </div>
</header>

<style>
.nav-wrap {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  padding-block: 1.8rem;
  transition:
    background 0.5s ease,
    padding 0.5s ease,
    box-shadow 0.5s ease,
    border-color 0.5s ease;
  border-bottom: 1px solid transparent;
}

.nav-wrap.scrolled {
  background: #f2f2f2;
  backdrop-filter: blur(14px);
  padding-block: 1.1rem;
  border-color: rgba(0,0,0,0.06);
  box-shadow: 0 2px 20px rgba(0,0,0,0.07);
}

/* Tres columnas: logo | links | cta */
.nav-inner {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 2rem;
}

/* Logo */
.nav-logo {
  display: flex;
  align-items: center;
}
.logo-img {
  height: 65px;
  width: auto;
  object-fit: contain;
  transition: height 0.5s ease;
}
.nav-wrap.scrolled .logo-img {
  height: 48px;
  filter: brightness(0) saturate(100%) invert(18%) sepia(60%) saturate(800%) hue-rotate(190deg);
}

/* Links */
.nav-links {
  display: flex;
  list-style: none;
  gap: 1.25rem;
  align-items: center;
  justify-content: center;
}

.nav-link {
  font-family: var(--font-body);
  font-size: 0.73rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 600;
  color: rgba(255,255,255,0.72);
  padding: 0.4rem 1rem;
  transition: color 0.2s;
  border-bottom: 2px solid transparent;
  white-space: nowrap;
}
.nav-link:hover { color: #ffffff; }
.nav-link.active {
  color: #ffffff;
  border-bottom-color: rgba(255,255,255,0.5);
}
.nav-wrap.scrolled .nav-link {
  color: var(--c-text-soft);
}
.nav-wrap.scrolled .nav-link:hover {
  color: var(--c-text);
}
.nav-wrap.scrolled .nav-link.active {
  color: var(--c-accent);
  border-bottom-color: var(--c-accent);
}
.nav-wrap.scrolled .nav-cta {
  border-color: var(--c-accent);
  color: var(--c-accent);
}
.nav-wrap.scrolled .nav-cta:hover {
  background: var(--c-accent);
  color: #ffffff;
}

/* Actions wrap */
.nav-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

/* CTA */
.nav-cta {
  font-family: var(--font-body);
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 700;
  padding: 0.6rem 1.6rem;
  border: 1.5px solid rgba(255,255,255,0.45);
  color: #ffffff;
  white-space: nowrap;
  border-radius: 50px;
  transition: background 0.25s, border-color 0.25s;
}
.nav-cta:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.8);
}

/* Lang toggle */
.lang-toggle {
  position: relative;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: #ffffff;
  border: 1.5px solid #ffffff;
  border-radius: 50px;
  padding: 5px 7px;
  cursor: pointer;
  user-select: none;
  flex-shrink: 0;
  white-space: nowrap;
  transition: background 0.25s, border-color 0.25s;
}
.lang-toggle:hover {
  background: #f0f0f0;
}
.lang-icon {
  flex-shrink: 0;
  color: #0d1f42;
  margin-left: 0.2rem;
}
.lang-track {
  position: relative;
  display: flex;
  align-items: center;
  border-radius: 50px;
  overflow: hidden;
  flex-shrink: 0;
}
.lang-opt {
  position: relative;
  z-index: 2;
  font-family: var(--font-body);
  font-size: 0.68rem;
  letter-spacing: 0.08em;
  font-weight: 700;
  padding: 0.45rem 0.95rem;
  color: #0d1f42;
  opacity: 0.4;
  white-space: nowrap;
  transition: opacity 0.3s ease;
  line-height: 1;
}
.lang-opt.active {
  opacity: 1;
}
.lang-indicator {
  position: absolute;
  top: 0;
  left: 0;
  width: 50%;
  height: 100%;
  background: rgba(13,31,66,0.08);
  border-radius: 50px;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 1;
}
.lang-toggle[data-active="en"] .lang-indicator {
  transform: translateX(100%);
}

.nav-wrap.scrolled .lang-toggle {
  border-color: var(--c-accent);
}
.nav-wrap.scrolled .lang-toggle:hover {
  background: #f0f0f0;
}

/* Mobile toggle */
.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
}
.nav-toggle span {
  display: block;
  width: 24px;
  height: 2px;
  background: #ffffff;
  transition: transform 0.3s, opacity 0.3s;
}

/* Mobile menu */
.mobile-menu {
  display: none;
  flex-direction: column;
  background: rgba(12, 28, 60, 0.98);
  padding: 1.5rem clamp(1.5rem, 4vw, 4rem);
  gap: 1rem;
  border-top: 1px solid rgba(255,255,255,0.08);
}
.mobile-link {
  font-size: 0.85rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.7);
  padding: 0.4rem 0;
  font-weight: 500;
}
.mobile-cta {
  align-self: flex-start;
  margin-top: 0.5rem;
}
.mobile-lang {
  align-self: flex-start;
  margin-top: 0.25rem;
  border-color: rgba(255,255,255,0.3);
}

@media (max-width: 768px) {
  .nav-links, .nav-cta { display: none; }
  .nav-actions { display: none; }
  .nav-toggle { display: flex; }
  .mobile-menu.open { display: flex; }
  .nav-inner {
    grid-template-columns: 1fr auto;
  }
}
</style>

<script>
  import { toggleLang } from '../scripts/i18n.js';

  const nav = document.getElementById('mainNav')!;
  const btn = document.getElementById('menuBtn')!;
  const menu = document.getElementById('mobileMenu')!;
  const langToggles = document.querySelectorAll<HTMLElement>('.lang-toggle');

  function handleScroll() {
    nav.classList.toggle('scrolled', window.scrollY > 50);
  }
  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  btn.addEventListener('click', () => menu.classList.toggle('open'));
  menu.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => menu.classList.remove('open'));
  });

  langToggles.forEach(t => {
    t.addEventListener('click', toggleLang);
    t.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleLang(); }
    });
  });
</script>