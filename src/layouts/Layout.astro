---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Guttemberg SRL | Home',
  description = 'Fabricación de piezas de precisión y mecanizado industrial. Calidad certificada, entregas puntuales.',
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
  </head>
  <body>
    <slot />
    <script>
      import { initLang } from '../scripts/i18n.js';
      initLang();
    </script>
  </body>
</html>